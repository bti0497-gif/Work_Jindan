{
  "name": "jindan-studio",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "main.cjs",
  "description": "더죤환경기술(주) 기술진단팀 협업스튜디오",
  "author": "Jindan Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k -n VITE,ELECTRON \"vite --host 127.0.0.1 --port 3000 --strictPort\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:debug": "cross-env DEBUG=electron-builder vite build && electron-builder",
    "publish": "vite build && node scripts/check-release-secrets.mjs && electron-builder --publish always"
  },
  "build": {
    "appId": "com.jindan.studio",
    "productName": "기술진단팀 협업스튜디오",
    "afterPack": "scripts/verify-package.cjs",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bti0497-gif",
        "repo": "Work_Jindan"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "jindan-studio-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "기술진단팀 협업스튜디오"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      "build/icon.ico",
      "main.cjs",
      "report-ai.cjs",
      "report-collector.cjs",
      "report-page-export.cjs",
      "drive-auth.cjs",
      "src/services/report/pageReproduction.js",
      "preload.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "cfb": "1.2.2",
    "dompurify": "3.4.17",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.8",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "lucide-react": "^0.563.0",
    "nasjidwg": "^0.18.0",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.4"
  }
}
