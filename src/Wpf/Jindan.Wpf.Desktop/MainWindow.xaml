<ui:FluentWindow x:Class="Jindan.Fluent.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shared="clr-namespace:Jindan.Fluent.Shared;assembly=Jindan.Wpf.Shared"
 Title="더죤환경기술(주) · 기술진단팀" WindowState="Maximized" ResizeMode="CanResize" Width="1200" Height="760" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}"
 FontFamily="Malgun Gothic" FontSize="13" UseLayoutRounding="True" AutomationProperties.AutomationId="JindanWpfShell">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <ui:TitleBar x:Name="AppTitle" Title="더죤환경기술(주) · 기술진단팀" ShowMaximize="True" ShowMinimize="True" Height="32">
   <ui:TitleBar.Icon><ui:ImageIcon Source="{x:Static shared:Branding.Logo}" /></ui:TitleBar.Icon>
  </ui:TitleBar>
  <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Menu x:Name="MainMenu" IsEnabled="False" Padding="8,2" ItemContainerStyle="{StaticResource CompactMenuItem}" AutomationProperties.AutomationId="MainMenu">
    <MenuItem Header="프로젝트"><MenuItem Header="프로젝트 열기…" Click="ChooseProject" /><MenuItem Header="프로젝트관리" IsEnabled="False" /><MenuItem Header="공정관리" IsEnabled="False" /></MenuItem>
    <MenuItem Header="파일관리" IsEnabled="False" /><MenuItem Header="할일관리" IsEnabled="False" />
    <MenuItem Header="보고서 스튜디오" IsEnabled="False" /><MenuItem Header="전체게시판" IsEnabled="False" />
    <MenuItem Header="회원관리" IsEnabled="False" /><MenuItem Header="설정"><MenuItem Header="로그아웃" Click="Logout" /></MenuItem>
   </Menu>
  </Border>
  <!-- Future sidebar and workspace DLL views are attached only after authenticated project selection. -->
  <Grid Grid.Row="2" x:Name="WorkspaceHost" />
 </Grid>
</ui:FluentWindow>
