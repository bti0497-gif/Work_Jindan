<ui:FluentWindow x:Class="Jindan.Fluent.Shared.ExitPrompt"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="앱 종료" Width="320" MinWidth="0" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
 Background="{DynamicResource ApplicationBackgroundBrush}">
 <StackPanel>
  <ui:TitleBar Title="앱 종료" Height="32" ShowMaximize="False" ShowMinimize="False" />
  <StackPanel Margin="22,8,22,22">
   <TextBlock Text="종료하시겠습니까?" FontSize="19" FontWeight="SemiBold" />
   <TextBlock Text="앱을 닫고 작업을 종료합니다." Margin="0,8,0,18" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button x:Name="CancelButton" Content="취소" IsCancel="True" MinWidth="76" Margin="0,0,8,0" />
    <ui:Button Content="확인" Appearance="Primary" MinWidth="76" Click="Confirm" />
   </StackPanel>
  </StackPanel>
 </StackPanel>
</ui:FluentWindow>
