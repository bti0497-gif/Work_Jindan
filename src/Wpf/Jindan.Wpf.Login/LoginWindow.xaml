<shared:StartupDialog x:Class="Jindan.Fluent.Login.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shared="clr-namespace:Jindan.Fluent.Shared;assembly=Jindan.Wpf.Shared"
 Title="더죤환경기술 · 로그인" Width="360" SizeToContent="Height" AutomationProperties.AutomationId="LoginWindow">
 <StackPanel>
  <ui:TitleBar Height="30" ShowMinimize="False" ShowMaximize="False" />
  <StackPanel Margin="24,4,24,24">
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Image Source="{x:Static shared:Branding.Logo}" Width="44" Height="44" AutomationProperties.Name="더죤 아이콘" />
    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="더죤환경기술(주)" FontSize="19" FontWeight="SemiBold" />
     <TextBlock Text="기술진단팀 협업 스튜디오" FontSize="12" Margin="0,2,0,0" />
    </StackPanel>
   </Grid>
   <Grid x:Name="Fields">
    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Label Content="아이디" Target="{Binding ElementName=LoginId}" Padding="0" VerticalAlignment="Center" FontSize="12" />
    <ui:TextBox x:Name="LoginId" Grid.Column="1" Height="32" MaxLength="128" AutomationProperties.Name="아이디" AutomationProperties.AutomationId="LoginId" />
    <Label Grid.Row="2" Content="비밀번호" Target="{Binding ElementName=Password}" Padding="0" VerticalAlignment="Center" FontSize="12" />
    <PasswordBox x:Name="Password" Grid.Row="2" Grid.Column="1" Height="32" MaxLength="1024" AutomationProperties.Name="비밀번호" AutomationProperties.AutomationId="LoginPassword" />
    <CheckBox x:Name="Remember" Grid.Row="3" Grid.Column="1" Content="아이디 저장" Margin="0,6,0,8" />
   </Grid>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
   <ui:Button x:Name="Submit" Content="로그인" Appearance="Primary" Height="34" HorizontalAlignment="Stretch" IsDefault="True" Click="SignIn" AutomationProperties.AutomationId="LoginSubmit" />
  </StackPanel>
 </StackPanel>
</shared:StartupDialog>
