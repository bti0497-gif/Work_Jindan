<shared:StartupDialog x:Class="Jindan.Fluent.Projects.ProjectWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shared="clr-namespace:Jindan.Fluent.Shared;assembly=Jindan.Wpf.Shared"
 Title="프로젝트 열기" Width="760" Height="434" AutomationProperties.AutomationId="ProjectSelection">
 <shared:StartupDialog.Resources>
  <SolidColorBrush x:Key="ProjectHeaderBrush" Color="#E7EEF8" />
  <SolidColorBrush x:Key="ProjectEditorBrush" Color="#F5F7FB" />
  <SolidColorBrush x:Key="ProjectListBrush" Color="#EEF3F8" />
  <SolidColorBrush x:Key="ProjectLineBrush" Color="#CAD6E5" />
  <SolidColorBrush x:Key="ProjectHeadingBrush" Color="#2B4568" />
  <Style x:Key="ProjectColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
   <Setter Property="Background" Value="#DCE6F3" /><Setter Property="Foreground" Value="#2B4568" />
   <Setter Property="Padding" Value="6,4" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
 </shared:StartupDialog.Resources>
 <Grid Background="{StaticResource ProjectListBrush}">
  <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <ui:TitleBar x:Name="DialogTitle" Title="프로젝트 열기" ShowMaximize="False" ShowMinimize="False" Height="32" Background="{StaticResource ProjectHeaderBrush}" Foreground="{StaticResource ProjectHeadingBrush}" />
  <Border Grid.Row="1" Background="{StaticResource ProjectHeaderBrush}" BorderBrush="{StaticResource ProjectLineBrush}" BorderThickness="0,0,0,1" Padding="20,8,20,14">
   <StackPanel><TextBlock x:Name="Heading" Text="프로젝트 열기" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ProjectHeadingBrush}" /><TextBlock x:Name="Subtitle" Text="작업할 프로젝트를 열어 주세요." FontSize="12" Margin="0,2,0,0" Foreground="#52647B" /></StackPanel>
  </Border>
  <Grid Grid.Row="2" x:Name="MainBody">
   <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Background="{StaticResource ProjectEditorBrush}" BorderBrush="{StaticResource ProjectLineBrush}" BorderThickness="0,0,1,0" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="새 프로젝트" Style="{StaticResource SectionTitle}" Foreground="{StaticResource ProjectHeadingBrush}" />
      <StackPanel IsEnabled="{Binding CanEdit}">
       <TextBlock Text="프로젝트명 *" Style="{StaticResource FieldLabel}" />
       <ui:TextBox x:Name="ProjectName" Height="32" MaxLength="300" PlaceholderText="프로젝트명을 입력하세요" Margin="0,0,0,10" AutomationProperties.Name="프로젝트명" />
       <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="시작일" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="StartDate" SelectedDateFormat="Short" AutomationProperties.Name="시작일" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="종료일" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="EndDate" SelectedDateFormat="Short" AutomationProperties.Name="종료일" /></StackPanel>
       </Grid>
       <TextBlock Text="프로젝트 내용" Style="{StaticResource FieldLabel}" />
       <ui:TextBox x:Name="Description" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="100000" AutomationProperties.Name="프로젝트 내용" />
      </StackPanel>
      <WrapPanel Margin="0,12,0,0">
       <ui:Button Content="{Binding CreateLabel}" IsEnabled="{Binding CanAct}" Click="Create" Margin="0,0,6,6" AutomationProperties.AutomationId="CreateProject" />
       <ui:Button Content="열기" Appearance="Primary" IsEnabled="{Binding CanOpen}" Click="Open" IsDefault="True" Margin="0,0,6,6" AutomationProperties.AutomationId="OpenProject" />
       <ui:Button x:Name="ExitButton" Content="취소 (나가기)" Click="Exit" Margin="0,0,0,6" />
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource ProjectListBrush}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="기존 프로젝트" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ProjectHeadingBrush}" /></DockPanel>
     <DataGrid x:Name="ProjectList" Grid.Row="1" Style="{StaticResource CompactGrid}" Background="{StaticResource ProjectListBrush}" RowBackground="#F8FAFD" AlternatingRowBackground="#EDF2F8" HorizontalGridLinesBrush="{StaticResource ProjectLineBrush}" ColumnHeaderStyle="{StaticResource ProjectColumnHeader}" ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanAct}" MouseDoubleClick="OpenByDoubleClick" AutomationProperties.Name="기존 프로젝트 목록">
      <DataGrid.Columns>
       <DataGridTextColumn Header="프로젝트명" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource SingleLineCell}" />
       <DataGridTextColumn Header="파일 경로" Binding="{Binding FileLocation}" Width="1.2*" MinWidth="160" ElementStyle="{StaticResource SingleLineCell}" />
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="2" Margin="0,10,0,8"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="FileNotice" TextWrapping="Wrap" FontSize="12" Foreground="#355078" AutomationProperties.LiveSetting="Polite" /></StackPanel>
     <WrapPanel Grid.Row="3">
      <ui:Button Content="새로고침" Click="Refresh" IsEnabled="{Binding CanAct}" Margin="0,0,6,4" />
      <ui:Button x:Name="FileOpenButton" Content="파일 열기…" Click="OpenProjectFile" IsEnabled="{Binding CanAct}" Margin="0,0,6,4" />
      <ui:Button Content="프로젝트 저장…" Click="SaveProjectFile" IsEnabled="{Binding CanOpen}" Margin="0,0,0,4" />
      <ui:Button Content="다시 로그인" Click="LoginAgain" Visibility="{Binding RequiresLogin, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" />
     </WrapPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</shared:StartupDialog>
