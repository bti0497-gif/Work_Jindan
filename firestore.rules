rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/jindan_members/$(request.auth.uid)).data;
    }
    function member() { return signedIn() && profile().isActive == true; }
    function admin() { return member() && profile().userLevel == 0; }
    function validPost(data, id) {
      return data.keys().hasAll(['id', 'menu', 'title', 'content', 'attachments', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted'])
        && data.keys().hasOnly(['id', 'menu', 'title', 'content', 'attachments', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted', 'migratedBy'])
        && data.id == id && data.menu in ['본사공지', '전체게시판']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 600000
        && data.attachments is list && data.attachments.size() <= 10
        && data.author is string && data.authorId is string && data.ownerUid is string
        && data.createdAt is string && data.updatedAt is string && data.deleted is bool;
    }
    match /jindan_members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() && request.auth.uid != uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.person_id is string
        && request.resource.data.userLevel in [0, 2] && request.resource.data.isActive is bool
        && !request.resource.data.keys().hasAny(['password', 'password_hash', 'passwordHash']);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'position', 'userLevel', 'isActive', 'updatedAt'])
        && request.resource.data.userLevel in [0, 2] && request.resource.data.isActive is bool
        && (request.auth.uid != uid || (request.resource.data.userLevel == resource.data.userLevel && request.resource.data.isActive == resource.data.isActive));
      allow delete: if false;
    }
    match /jindan_board_posts/{id} {
      allow read: if member();
      allow create: if member() && validPost(request.resource.data, id)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deleted == false
        && (!('migratedBy' in request.resource.data) || (admin() && request.resource.data.migratedBy == request.auth.uid));
      allow update: if member() && (resource.data.ownerUid == request.auth.uid || admin())
        && validPost(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'attachments', 'updatedAt', 'deleted'])
        && resource.data.deleted == false;
      // 삭제는 deleted 플래그로 처리하여 복구 가능하게 보존한다.
      allow delete: if false;
    }
    match /jindan_board_comments/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['id', 'postId', 'ownerUid', 'author', 'content', 'createdAt'])
        && request.resource.data.id == id
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 10000
        && request.resource.data.createdAt is string
        && getAfter(/databases/$(database)/documents/jindan_board_posts/$(request.resource.data.postId)).data.deleted == false;
      allow update, delete: if false;
    }
    function validWorkBase(data, id) {
      return data.keys().hasAll(['id', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted'])
        && data.id == id && id.size() > 0 && id.size() <= 128
        && data.author is string && data.author.size() <= 300
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.ownerUid is string && data.ownerUid.size() > 0
        && data.createdAt is string && data.updatedAt is string && data.deleted is bool;
    }
    function validWorkRange(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startDate <= data.endDate;
    }
    function unchangedWorkOwner() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function ownWork() {
      return resource.data.ownerUid == request.auth.uid || resource.data.authorId == profile().person_id;
    }
    function validProject(data, id) {
      return validWorkBase(data, id) && validWorkRange(data)
        && data.keys().hasOnly(['id', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted', 'title', 'content', 'startDate', 'endDate'])
        && data.content is string && data.content.size() <= 600000;
    }
    match /jindan_projects/{id} {
      allow read: if member();
      allow create: if member() && validProject(request.resource.data, id)
        && request.resource.data.ownerUid == request.auth.uid && !request.resource.data.deleted
        && (request.resource.data.authorId == profile().person_id || admin());
      allow update: if member() && (ownWork() || admin()) && !resource.data.deleted
        && validProject(request.resource.data, id) && unchangedWorkOwner();
      allow delete: if false;
    }
    function validProcess(data, id) {
      return validWorkBase(data, id) && validWorkRange(data)
        && data.keys().hasOnly(['id', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted', 'title', 'projectId', 'startDate', 'endDate', 'isCompleted'])
        && data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 128
        && data.isCompleted is bool;
    }
    match /jindan_processes/{id} {
      allow read: if member();
      allow create: if member() && validProcess(request.resource.data, id)
        && request.resource.data.ownerUid == request.auth.uid && !request.resource.data.deleted
        && (request.resource.data.authorId == profile().person_id || admin());
      // 공정은 팀 공동 업무이며 작성자와 소속 프로젝트는 보존한다.
      allow update: if member() && !resource.data.deleted && validProcess(request.resource.data, id)
        && unchangedWorkOwner() && request.resource.data.projectId == resource.data.projectId;
      allow delete: if false;
    }
    function validTask(data, id) {
      return validWorkBase(data, id)
        && data.keys().hasOnly(['id', 'author', 'authorId', 'ownerUid', 'createdAt', 'updatedAt', 'deleted', 'date', 'content', 'isPublic'])
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.content is string && data.content.size() > 0 && data.content.size() <= 20000
        && data.isPublic is bool;
    }
    match /jindan_tasks/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/jindan_tasks/$(id)) || resource.data.isPublic || resource.data.authorId == profile().person_id);
      allow list: if member() && (resource.data.isPublic || resource.data.authorId == profile().person_id);
      allow create: if member() && validTask(request.resource.data, id)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorId == profile().person_id && !request.resource.data.deleted;
      allow update: if member() && resource.data.authorId == profile().person_id && !resource.data.deleted
        && validTask(request.resource.data, id) && unchangedWorkOwner();
      allow delete: if false;
    }
    // 기존 posts/comments 등 다른 앱의 데이터에는 접근 권한을 추가하지 않는다.
    match /{document=**} { allow read, write: if false; }
  }
}
