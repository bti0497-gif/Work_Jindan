<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><UseWindowsForms>true</UseWindowsForms><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup><Compile Include="GuiSmoke.cs" /></ItemGroup>
  <ItemGroup Condition="'$(InstallationRoot)' == ''"><ProjectReference Include="../../src/Jindan.Report.Adapter/Jindan.Report.Adapter.csproj" /><ProjectReference Include="../../src/Jindan.Infrastructure/Jindan.Infrastructure.csproj" /><ProjectReference Include="../../src/Modules/ReportStudio/Jindan.Modules.ReportStudio.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(InstallationRoot)' != ''">
    <Reference Include="Jindan.Contracts"><HintPath>$(InstallationRoot)/Jindan.Contracts.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Jindan.Core"><HintPath>$(InstallationRoot)/Jindan.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Jindan.Desktop.Contracts"><HintPath>$(InstallationRoot)/Jindan.Desktop.Contracts.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Jindan.Infrastructure"><HintPath>$(InstallationRoot)/Jindan.Infrastructure.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Jindan.Report.Adapter"><HintPath>$(InstallationRoot)/Jindan.Report.Adapter.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Jindan.Modules.ReportStudio"><HintPath>$(InstallationRoot)/modules/report-studio/Jindan.Modules.ReportStudio.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireExactInstallation" BeforeTargets="ResolveReferences" Condition="'$(InstallationRoot)' != ''"><Error Condition="!Exists('$(InstallationRoot)/modules/report-studio/Jindan.Modules.ReportStudio.dll')" Text="InstallationRoot must contain the exact packaged report module." /></Target>
</Project>
