# Google Drive API 설정 (Electron 메인 프로세스 전용)
# https://console.cloud.google.com/ 에서 발급받은 값을 입력하세요.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# 리프레시 토큰 및 폴더 ID
# 인증 정보는 렌더러에 노출하지 않습니다. 폴더 ID만 공개 설정입니다.
GOOGLE_REFRESH_TOKEN=your_refresh_token_here
VITE_GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# 기타 설정
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=file:./dev.db
GEMINI_API_KEY=your_gemini_api_key_here

# 이메일 전송 설정
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password_here
EMAIL_FROM="Your Name <your_email@gmail.com>"

# Firebase board (Web SDK public app configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=work-jindan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=work-jindan
VITE_FIREBASE_APP_ID=
